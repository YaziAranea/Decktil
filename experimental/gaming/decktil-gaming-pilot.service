[Unit]
Description=Decktil keyboard for Steam Library search
After=gamescope-session.service
PartOf=gamescope-session.target
ConditionPathExists=%t/gamescope-environment

[Service]
Type=simple
EnvironmentFile=%t/gamescope-environment
UMask=0077
ExecStart=/usr/bin/python3 -Bs %h/.local/share/decktil-gaming/current/experimental/gaming/session.py
Slice=session.slice
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=gamescope-session.target
